# ===== AI provider — add ONE key and restart the server =====
# The server auto-detects whichever key is present.

# OpenAI (default model: gpt-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (default model: claude-sonnet-4-5)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (default model: gemini-3.6-flash)
# Accepts both legacy AIza... keys and the new AQ... auth keys
# GEMINI_API_KEY=AIza... or AQ...
# GEMINI_MODEL=gemini-3.5-flash-lite  (flash-lite has the highest free-tier rate limit; flagship flash models cap at ~20 req/min)

# Groq — free tier available (default model: llama-3.3-70b-versatile)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — gateway to many models
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama — fully local, no key needed, just a running Ollama server
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Force a specific provider when several keys are present (optional)
# AI_PROVIDER=groq

# ===== Server =====
# PORT=3001

# ===== Storage =====
# Leave MONGODB_URI empty to use local SQLite (data/skilling.db).
# Paste your Atlas connection string to switch every read/write to MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=skilling   (optional - defaults to the db name in the URI, or "skilling")
