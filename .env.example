# ===== AI provider — add ONE key and restart the server =====
# The server auto-detects whichever key is present.

# OpenAI (default model: gpt-4o-mini)
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini

# Anthropic (default model: claude-sonnet-4-5)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Google Gemini (default model: gemini-2.0-flash)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-2.0-flash

# Groq — free tier available (default model: llama-3.3-70b-versatile)
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile

# OpenRouter — gateway to many models
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_MODEL=openai/gpt-4o-mini

# Ollama — fully local, no key needed, just a running Ollama server
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Force a specific provider when several keys are present (optional)
# AI_PROVIDER=groq

# ===== Server =====
# PORT=3001
